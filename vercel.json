{"version": 2, "functions": {"api/gateway.js": {"maxDuration": 60}}, "headers": [{"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}, {"key": "X-Frame-Options", "value": "DENY"}]}], "rewrites": [{"source": "/api/:path*", "destination": "/api/gateway?route=:path*"}]}